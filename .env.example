# Copy to .env for local development. Never commit secrets.
# Demo / synthetic data only — not a production HIPAA deployment.

NODE_ENV=development

# PostgreSQL (Docker Compose default — demo / local API)
DATABASE_URL=postgresql://claimchecker:claimchecker@127.0.0.1:55432/claimchecker?schema=public
# Isolated DB for API integration tests (never wipe demo data)
TEST_DATABASE_URL=postgresql://claimchecker:claimchecker@127.0.0.1:55432/claimchecker_test?schema=public


# API
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-real-deployments
COOKIE_NAME=cc_session
UPLOAD_MAX_BYTES=2097152
UPLOAD_DIR=./uploads
PRODUCT_NAME=Claim Checker

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Optional AI (disabled unless set)
AI_ENABLED=false
# OPENAI_API_KEY=
# AI_MODEL=
# AI_TIMEOUT_MS=8000
