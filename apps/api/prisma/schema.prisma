generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  member
}

enum UploadStatus {
  pending
  processing
  completed
  failed
}

enum ValidationRunStatus {
  pending
  running
  completed
  failed
}

enum FindingSeverity {
  error
  warning
  info
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  uploads         Upload[]
  claims          Claim[]
  validationRuns  ValidationRun[]
  auditLogs       AuditLog[]
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  email          String   @unique
  passwordHash   String
  role           UserRole @default(member)
  /// Incremented on logout so previously issued JWTs stop working.
  tokenVersion   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploads      Upload[]
  auditLogs    AuditLog[]

  @@index([organizationId])
}

model Upload {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  filename       String
  byteSize       Int
  contentHash    String
  status         UploadStatus @default(pending)
  /// User-safe summary; never raw EDI
  errorSummary   String?
  /// Structured parser errors (codes/messages); never raw EDI body
  parserErrors   Json?
  /// Filesystem/object key only — raw EDI lives outside the DB
  storageKey     String
  transactionSet String?
  igVersion      String?
  interchangeControlNumber String?
  groupControlNumber       String?
  transactionControlNumber String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  claims         Claim[]
  validationRuns ValidationRun[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

model Claim {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  uploadId           String   @db.Uuid
  claimControlNumber String
  totalCharge        Decimal? @db.Decimal(12, 2)
  placeOfServiceCode String?
  billingProviderNpi String?
  billingProviderName String?
  subscriberMemberId String?
  subscriberLastName String?
  subscriberFirstName String?
  sourceLocation     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  upload       Upload              @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  lines        ClaimLine[]
  diagnoses    Diagnosis[]
  findings     ValidationFinding[]

  @@unique([uploadId, claimControlNumber])
  @@index([organizationId, createdAt])
  @@index([uploadId])
}

model ClaimLine {
  id                     String    @id @default(uuid()) @db.Uuid
  claimId                String    @db.Uuid
  lineNumber             Int
  procedureCode          String?
  procedureCodeQualifier String?
  modifiers              String[]  @default([])
  charge                 Decimal?  @db.Decimal(12, 2)
  unitCode               String?
  units                  String?
  diagnosisPointers      Int[]     @default([])
  serviceDate            String?
  sourceLocation         Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  claim    Claim               @relation(fields: [claimId], references: [id], onDelete: Cascade)
  findings ValidationFinding[]

  @@unique([claimId, lineNumber])
  @@index([claimId])
}

model Diagnosis {
  id             String   @id @default(uuid()) @db.Uuid
  claimId        String   @db.Uuid
  sequence       Int
  code           String
  codeSet        String
  sourceLocation Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, sequence])
  @@index([claimId])
}

model ValidationRun {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  uploadId       String              @db.Uuid
  ruleSetVersion String
  status         ValidationRunStatus @default(pending)
  startedAt      DateTime?
  finishedAt     DateTime?
  summaryCounts  Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  upload       Upload              @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  findings     ValidationFinding[]

  @@index([organizationId, createdAt])
  @@index([uploadId])
}

model ValidationFinding {
  id              String          @id @default(uuid()) @db.Uuid
  validationRunId String          @db.Uuid
  claimId         String?         @db.Uuid
  claimLineId     String?         @db.Uuid
  ruleId          String
  severity        FindingSeverity
  message         String
  sourceLocation  Json?
  suggestedAction String?
  /// Non-PHI structural evidence only
  evidence        Json?
  createdAt       DateTime        @default(now())

  validationRun ValidationRun @relation(fields: [validationRunId], references: [id], onDelete: Cascade)
  claim         Claim?        @relation(fields: [claimId], references: [id], onDelete: SetNull)
  claimLine     ClaimLine?    @relation(fields: [claimLineId], references: [id], onDelete: SetNull)

  @@index([validationRunId, severity])
  @@index([claimId])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  resourceType   String
  resourceId     String?
  /// Must never contain raw EDI
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
